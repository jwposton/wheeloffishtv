# Wheel of Fish TV — environment configuration
# Copy to .env and customize: cp .env.example .env

# Required — generate with: openssl rand -hex 32
WOF_SECRET_KEY=

# Database (default: SQLite on Docker volume)
DATABASE_URL=sqlite:////data/wheeloffish.db

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment label
ENVIRONMENT=production

# Enabled media providers (comma-separated: plex, jellyfin)
WOF_ENABLED_PROVIDERS=plex,jellyfin

# Plex OAuth product name shown during PIN flow
WOF_PLEX_PRODUCT_NAME=Wheel of Fish TV

# Base URL for OAuth callback redirects (no trailing slash)
WOF_OAUTH_CALLBACK_BASE=http://localhost:8000

# Catalog sync chunk size and default page size
WOF_CATALOG_SYNC_CHUNK_SIZE=100
WOF_CATALOG_PAGE_DEFAULT=50

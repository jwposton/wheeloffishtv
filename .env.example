# Wheel of Fish TV — environment configuration
# Copy to .env and customize: cp .env.example .env
#
# No admin user IDs are required. After users sign in via Plex/Jellyfin,
# they manage TV library scope under Settings → Libraries in the web UI.

# Required — generate with: openssl rand -hex 32
WOF_SECRET_KEY=

# Database (default: SQLite on Docker volume)
DATABASE_URL=sqlite:////data/wheeloffish.db

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment label
ENVIRONMENT=production

# File ownership for /data (SQLite, artwork). Entrypoint remaps the app user to these ids.
# Match your host user when bind-mounting ./data (id -u / id -g).
PUID=1000
PGID=1000

# Media server provider for this install (plex or jellyfin)
WOF_PROVIDER=plex

# Media server base URL (no trailing slash)
WOF_MEDIA_SERVER_URL=http://localhost:32400

# Display name shown in UI
WOF_MEDIA_SERVER_DISPLAY_NAME=Media Server

# Verify TLS certificates when connecting to the media server
WOF_VERIFY_SSL=true

# Session cookie lifetime in days; unset = long-lived session (D-05)
# WOF_SESSION_DAYS=30

# Plex OAuth product name shown during PIN flow
WOF_PLEX_PRODUCT_NAME=Wheel of Fish TV

# Base URL for OAuth callback redirects (no trailing slash)
WOF_OAUTH_CALLBACK_BASE=http://localhost:8000

# Catalog sync chunk size and default page size
WOF_CATALOG_SYNC_CHUNK_SIZE=500
WOF_CATALOG_PAGE_DEFAULT=50

# Optional comma-separated library native IDs to bootstrap in-scope libraries on sync (per-user scope is managed in Settings → Libraries)
WOF_SCOPED_LIBRARY_IDS=

# Local poster cache directory (Docker volume /data/artwork; scoped per user)
WOF_ARTWORK_CACHE_DIR=/data/artwork

# Re-fetch posters after this many days (0 = never expire on disk)
WOF_ARTWORK_CACHE_TTL_DAYS=30

# IANA timezone for the household/server location (D-01); used for nightly rebuild scheduling
# WOF_INSTALL_TIMEZONE=America/New_York

# Nightly rebuild time in HH:MM local (WOF_INSTALL_TIMEZONE); not UTC unless timezone is UTC (D-01)
# WOF_REBUILD_CRON=04:00
